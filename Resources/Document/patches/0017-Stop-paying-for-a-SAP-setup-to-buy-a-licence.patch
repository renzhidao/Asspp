+        error instanceof PurchaseError &&
+        (error.code === "2034" || error.code === "2042");
+      if (!expired) throw error;
+
       const renewed = await authenticate(
         account.email,
         account.password,
@@ -93,11 +116,9 @@ export function useDownloadAction() {
