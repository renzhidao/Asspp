+  return events.map((event) =>
+    event.endedAt !== undefined
+      ? `  ${event.label}  ${at(event.at)}  took ${((event.endedAt - event.at) / 1000).toFixed(1)}s`
+      : `  ${event.label}  ${at(event.at)}  STILL RUNNING`,
+  );
