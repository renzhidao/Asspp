+        customerMessage,
+        `store=${account.store}`,
+        `keys=${keys.join(",") || "none"}`,
+      ]
+        .filter(Boolean)
+        .join(" ");
+      throw new DownloadError(
+        `${i18n.t("errors.download.noItems")} (${evidence})`,
+      );
     }
 
     const item = songList[0];
