 frontend/src/store/sap.ts                     | 25 +++++++-
 frontend/src/utils/diagnostics.ts             | 48 ++++++++++++---
 frontend/tests/store/sap.test.ts              | 61 +++++++++++++++++++
 .../utils/diagnosticsSetupTimeline.test.ts    | 40 ++++++++++++
 4 files changed, 161 insertions(+), 13 deletions(-)
